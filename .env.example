# Copy to .env to override defaults. Everything here is optional.

# Linux only: run containers as your user so files in ./data are owned by you.
#   echo "AIRFLOW_UID=$(id -u)" > .env
# AIRFLOW_UID=50000

# Show the ~50 official example DAGs next to the tutorial ones.
# AIRFLOW_LOAD_EXAMPLES=true

# Admin login for the UI.
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow

# Quick way to try extra pip packages (rebuild an image for anything serious).
# _PIP_ADDITIONAL_REQUIREMENTS=pandas
